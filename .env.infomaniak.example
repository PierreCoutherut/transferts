# Copier ce fichier en .env dans le dossier qui contient package.json.
NODE_ENV=production
BASE_URL=https://transferts.pierre-coutherut.fr
HOST=0.0.0.0
# Ne pas ajouter PORT : le Manager Infomaniak le fournit au processus Node.
# Remplacer par un dossier ABSOLU, privé, persistant, accessible à l’application,
# situé hors public/ et hors du répertoire remplacé lors d’un déploiement.
DATA_DIR=/REMPLACER_PAR_LE_CHEMIN_PRIVE/transferts-data
ADMIN_USERNAME=pierre
# Accès par lien privé : aucune configuration de mot de passe nécessaire.
ADMIN_AUTH_MODE=link
# Le lien et le secret de session sont générés dans DATA_DIR.
# Afficher le lien en SSH avec npm run admin-link.
# Valeur à confirmer selon les proxys du site Infomaniak ; adapter si nécessaire.
TRUST_PROXY=1
MAX_FILE_BYTES=2147483648
MAX_TRANSFER_BYTES=21474836480
MAX_FILES=1000
PHOTO_API_URL=https://api.pierre-coutherut.fr
BESTS_GALLERY_ID=8c5ae7e1-e5b3-4738-adde-4d4041f99405
# Renseigner les paramètres de votre messagerie uniquement dans .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Mot de passe IMAP/SMTP spécifique créé pour cette adresse, pas celui du Manager.
# Mettre la valeur entre guillemets si elle contient # ou des espaces.
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
