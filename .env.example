NODE_ENV=production
PORT=3000
# Infomaniak Node.js : HOST=0.0.0.0 et conserver le PORT fourni par le Manager.
HOST=127.0.0.1
BASE_URL=https://transferts.pierre-coutherut.fr
# Chemin persistant, hors du répertoire public, accessible uniquement à ce service.
DATA_DIR=./data
ADMIN_USERNAME=pierre
# Accès par lien privé : aucune configuration de mot de passe nécessaire.
ADMIN_AUTH_MODE=link
# Le lien et le secret de session sont générés dans DATA_DIR.
# Afficher le lien en SSH avec npm run admin-link.
# Nombre de proxys de confiance entre le navigateur et Node (Nginx local : 1).
TRUST_PROXY=1
# Limites en octets : 2 Go/fichier, 20 Go/transfert, 1000 fichiers/transfert.
MAX_FILE_BYTES=2147483648
MAX_TRANSFER_BYTES=21474836480
MAX_FILES=1000
# BESTS est public : aucun identifiant de ton API n'est nécessaire.
PHOTO_API_URL=https://api.pierre-coutherut.fr
BESTS_GALLERY_ID=8c5ae7e1-e5b3-4738-adde-4d4041f99405
# Facultatif. Sans SMTP, les liens sont utilisables mais aucun e-mail ne part.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pierre Coutherut <transferts@pierre-coutherut.fr>
MAIL_REPLY_TO=
